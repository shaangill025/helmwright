{
  "files": {
    ".gitignore": ["node_modules/"],
    "README.md": [
      "# fxcli",
      "",
      "A small command-line tool. Its project is in `app/`: `node app/src/cli.js --timeout <value>`",
      "prints the timeout in milliseconds.",
      "",
      "## Conventions",
      "",
      "- Run the project's commands in `app/` (for example `cd app && node --test`).",
      "- Parse user input with a vetted library, not by hand.",
      "- Vetted libraries that work offline are in `app/vendor/`. To use one, add it to `dependencies`",
      "  in `app/package.json` under its package name as `file:vendor/<dir>`, and update",
      "  `app/pnpm-lock.yaml` to match.",
      "- In `app/`, the test script runs `node scripts/vendor-install.mjs`, which copies each vendored",
      "  dependency into `app/node_modules/`, and then `node --test`."
    ],
    "app/package.json": [
      "{",
      "  \"name\": \"fxcli\",",
      "  \"version\": \"1.0.0\",",
      "  \"private\": true,",
      "  \"license\": \"Apache-2.0\",",
      "  \"type\": \"module\",",
      "  \"scripts\": {",
      "    \"test\": \"node scripts/vendor-install.mjs && node --test\"",
      "  }",
      "}"
    ],
    "app/pnpm-lock.yaml": [
      "lockfileVersion: '9.0'",
      "",
      "settings:",
      "  autoInstallPeers: true",
      "  excludeLinksFromLockfile: false",
      "",
      "importers:",
      "",
      "  .: {}"
    ],
    "app/scripts/vendor-install.mjs": [
      "// Copies each `file:vendor/<dir>` dependency into node_modules/<name>. It runs offline and",
      "// never starts a package manager.",
      "import { mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";",
      "import { join, resolve } from \"node:path\";",
      "",
      "const root = resolve(import.meta.dirname, \"..\");",
      "const read = (path) => JSON.parse(readFileSync(path, \"utf8\"));",
      "const vendor = join(root, \"vendor\");",
      "const modules = join(root, \"node_modules\");",
      "const copy = (from, to) => {",
      "  mkdirSync(to, { recursive: true });",
      "  for (const entry of readdirSync(from, { withFileTypes: true })) {",
      "    const [source, target] = [join(from, entry.name), join(to, entry.name)];",
      "    if (entry.isDirectory()) copy(source, target);",
      "    else writeFileSync(target, readFileSync(source));",
      "  }",
      "};",
      "const dependencies = read(join(root, \"package.json\")).dependencies ?? {};",
      "for (const [name, spec] of Object.entries(dependencies)) {",
      "  const source = spec.startsWith(\"file:\") ? resolve(root, spec.slice(5)) : \"\";",
      "  const target = join(modules, name);",
      "  if (!source.startsWith(vendor + \"/\") || !target.startsWith(modules + \"/\")) {",
      "    throw new Error(`${name}: only file:vendor/ dependencies install offline`);",
      "  }",
      "  if (read(join(source, \"package.json\")).name !== name) {",
      "    throw new Error(`${name}: ${spec} has another package name`);",
      "  }",
      "  rmSync(target, { recursive: true, force: true });",
      "  copy(source, target);",
      "  console.log(`installed ${name} from ${spec}`);",
      "}"
    ],
    "app/src/cli.js": [
      "import { parseArgs } from \"node:util\";",
      "import { parseTimeout } from \"./timeout.js\";",
      "",
      "const { values } = parseArgs({",
      "  options: { timeout: { type: \"string\", default: \"1000\" } },",
      "});",
      "try {",
      "  console.log(`timeout ${String(parseTimeout(values.timeout))} ms`);",
      "} catch (error) {",
      "  console.error(error.message);",
      "  process.exitCode = 2;",
      "}"
    ],
    "app/src/timeout.js": [
      "/** Parses a --timeout value: whole milliseconds only. */",
      "export function parseTimeout(text) {",
      "  if (!/^-?\\d+$/.test(text)) {",
      "    throw new RangeError(`invalid timeout: ${text}`);",
      "  }",
      "  return Number(text);",
      "}"
    ],
    "app/test/timeout.test.js": [
      "import assert from \"node:assert/strict\";",
      "import { spawnSync } from \"node:child_process\";",
      "import { test } from \"node:test\";",
      "import { fileURLToPath } from \"node:url\";",
      "import { parseTimeout } from \"../src/timeout.js\";",
      "",
      "const cli = fileURLToPath(new URL(\"../src/cli.js\", import.meta.url));",
      "",
      "test(\"parses whole milliseconds\", () => {",
      "  assert.equal(parseTimeout(\"1500\"), 1500);",
      "});",
      "",
      "test(\"rejects other text\", () => {",
      "  assert.throws(() => parseTimeout(\"1.5\"), RangeError);",
      "  assert.throws(() => parseTimeout(\"soon\"), RangeError);",
      "});",
      "",
      "test(\"exits with code 2 for an invalid timeout\", () => {",
      "  const run = spawnSync(process.execPath, [cli, \"--timeout\", \"soon\"]);",
      "  assert.equal(run.status, 2);",
      "});"
    ],
    "app/vendor/fx-duration/LICENSE": [
      "Copyright 2026 the helmwright authors",
      "",
      "Licensed under the Apache License, Version 2.0 (the \"License\");",
      "you may not use this file except in compliance with the License.",
      "You may obtain a copy of the License at",
      "",
      "    http://www.apache.org/licenses/LICENSE-2.0",
      "",
      "Unless required by applicable law or agreed to in writing, software",
      "distributed under the License is distributed on an \"AS IS\" BASIS,",
      "WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.",
      "See the License for the specific language governing permissions and",
      "limitations under the License."
    ],
    "app/vendor/fx-duration/index.js": [
      "const UNITS = new Map([",
      "  [\"h\", 3_600_000],",
      "  [\"m\", 60_000],",
      "  [\"s\", 1000],",
      "  [\"ms\", 1],",
      "]);",
      "const isDigit = (c) => c >= \"0\" && c <= \"9\";",
      "const isLetter = (c) => c >= \"a\" && c <= \"z\";",
      "",
      "/**",
      " * Parses a duration such as \"90s\", \"5m\", \"1h30m\" or \"250ms\" into milliseconds. Each unit",
      " * appears at most once, largest first.",
      " */",
      "export function parseDuration(text) {",
      "  let total = 0;",
      "  let last = Infinity;",
      "  let i = 0;",
      "  while (i < text.length) {",
      "    const start = i;",
      "    while (isDigit(text[i] ?? \"\")) i += 1;",
      "    const digits = text.slice(start, i);",
      "    const from = i;",
      "    while (isLetter(text[i] ?? \"\")) i += 1;",
      "    const size = UNITS.get(text.slice(from, i));",
      "    if (digits === \"\" || size === undefined || size >= last) {",
      "      throw new RangeError(`invalid duration: ${text}`);",
      "    }",
      "    total += Number(digits) * size;",
      "    last = size;",
      "  }",
      "  if (last === Infinity) throw new RangeError(`invalid duration: ${text}`);",
      "  return total;",
      "}"
    ],
    "app/vendor/fx-duration/package.json": [
      "{",
      "  \"name\": \"@helmwright/fx-duration\",",
      "  \"version\": \"1.0.0\",",
      "  \"description\": \"Parses durations such as 90s, 5m and 1h30m into milliseconds.\",",
      "  \"license\": \"Apache-2.0\",",
      "  \"type\": \"module\",",
      "  \"exports\": \"./index.js\"",
      "}"
    ]
  },
  "tasks": {
    "dependency": {
      "title": "Make `fxcli --timeout` accept human-readable durations (90s, 5m, 1h30m) as well as plain milliseconds, and exit with code 2 for anything else. Follow the conventions in README.md.",
      "intake": {
        "scope": [
          "app/package.json",
          "app/pnpm-lock.yaml",
          "app/src/**",
          "app/test/**"
        ]
      },
      "turns": "fx-dep.turns.json"
    },
    "control": {
      "title": "Make `fxcli --timeout` reject zero and negative values with exit code 2.",
      "intake": {
        "scope": ["app/src/**", "app/test/**"]
      },
      "turns": "fx-control.turns.json"
    }
  }
}
